generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum KitCondition {
  NEW_WITH_TAGS
  EXCELLENT
  VERY_GOOD
  GOOD
  FAIR
}

enum KitVersion {
  REPLICA
  AUTHENTIC
  PLAYER_ISSUE
  MATCH_WORN
}

enum JerseyType {
  HOME
  AWAY
  THIRD
  FOURTH
  SPECIAL
  GOALKEEPER
  TRAINING
}

model User {
  id              String        @id @default(uuid())
  username        String        @unique
  email           String        @unique
  password        String? // optionnal to allow for OAuth users, but mandatory for users registering with email/password thanks to class-validator in the DTOs
  isPublic        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  role            Role          @default(USER)
  resetCode       String? // optionnal, used for password reset
  resetCodeExpiry DateTime? // optionnal, used for password reset
  jerseys         Jersey[]
  wishlist        Wishlist[]
  subscription    Subscription? // one-to-one relationship with Subscriptions
  jerseyLikes     JerseyLike[] // one-to-many relationship with JerseyLike
}

model Subscription {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  status   String // 'active', 'canceled', 'past_due'
  planType String // 'PRO_MONTHLY', 'PRO_YEARLY', FREE

  // key dates for subscription management
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  createdAt          DateTime @default(now())
}

model Jersey {
  id            String       @id @default(uuid())
  userId        String
  sportId       String
  clubId        String
  frontImageUrl String
  backImageUrl  String? // optionnal because some jerseys don't have a back image
  playerName    String?
  number        Int?
  season        String?
  type          JerseyType
  size          String? // e.g., S, M, L, XL, etc.
  condition     KitCondition
  version       KitVersion
  brand         String
  isOfficial    Boolean?
  description   String? // e.g., any additional details about the jersey : buy at the stadium, signed by the player, etc.
  purchasePrice Float? // optionnal because some jerseys are gifts or free
  isShareable   Boolean? // optionnal because user may not want to share the jersey with other users
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  sport         Sport        @relation(fields: [sportId], references: [id])
  club          Club         @relation(fields: [clubId], references: [id])
  likes         JerseyLike[]
}

model JerseyLike {
  id        String   @id @default(uuid())
  jerseyId  String
  jersey    Jersey   @relation(fields: [jerseyId], references: [id], onDelete: Cascade)
  userId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([jerseyId, userId]) // To avoid a user liking the same jersey multiple times
}

model Sport {
  id      String   @id @default(uuid())
  name    String   @unique
  clubs   Club[]
  jerseys Jersey[]
}

model Club {
  id       String     @id @default(uuid())
  sportId  String
  name     String
  logoUrl  String? // logo url from Api-football
  sport    Sport      @relation(fields: [sportId], references: [id])
  jerseys  Jersey[]
  wishlist Wishlist[]

  // Ensure that the combination of sportId and name is unique
  @@unique([sportId, name])
}

model Wishlist {
  id         String   @id @default(cuid())
  userId     String
  clubId     String
  season     String?
  playerName String?
  number     Int?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  club       Club     @relation(fields: [clubId], references: [id])
}
