# API-Football key (used for club search fallback)
EXPO_PUBLIC_API_FOOTBALL_KEY="your_api_football_key"

# RevenueCat public SDK key (subscriptions)
EXPO_PUBLIC_REVENUECAT_API_KEY="your_revenuecat_key"

# Backend API URL — choose the one matching your environment
EXPO_PUBLIC_API_URL="http://192.168.1.15:3000"
