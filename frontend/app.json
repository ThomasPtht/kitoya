{
  "expo": {
    "name": "Kitoya",
    "slug": "kitoya",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "kitoya",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kitoya.app",
      "useAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "locales": {
      "en": "./native-locales/en.json",
      "fr": "./native-locales/fr.json",
      "es": "./native-locales/es.json"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.kitoya.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-localization",
      [
        "expo-splash-screen",
        {
          "ios": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon.png",
            "resizeMode": "contain",
            "imageWidth": 200
          },
          "android": {
            "backgroundColor": "#000000",
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 150
          }
        }
      ],
      [
        "expo-image-picker",
         {
      "photosPermission": "Kitoya needs access to your photo library so you can select an existing picture of your jersey to add it to your collection.",
      "cameraPermission": "Kitoya needs access to your camera so you can take a photo of your jersey to add it to your collection."
    }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "63a5af18-decf-42af-a98b-fa1b774a5b6e"
      }
    }
  }
}
